{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [],
    "allow": [
      "Bash(pytest tests/*)",
      "Bash(pytest)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript >/dev/null && osascript -e 'display notification \"Claude finished\" with title \"ai-tools-training\"' || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  }
}
