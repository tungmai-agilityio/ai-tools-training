{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.instructor/**)",
      "Edit(/.instructor/**)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-forbidden-command.py\""
          }
        ]
      }
    ]
  }
}
