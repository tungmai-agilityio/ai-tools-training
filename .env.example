# Copy to .env and fill in. Never commit a real .env.
CLINIC_TIMEZONE=America/New_York
DB_PATH=data/clinic.db
# Authentication (leave empty here; set real values only in your own .env)
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=true
# 1 books demo appointments at startup while none exist. Staging only; leave unset in production.
DEMO_SEED=
# Set by Render to the commit it runs, which /health reports. Leave unset locally (the field is null).
RENDER_GIT_COMMIT=
